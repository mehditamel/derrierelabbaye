# Réservations — envoi des demandes par e-mail (Resend).
# Sans RESEND_API_KEY, le formulaire refuse la demande et invite à téléphoner :
# il n'affiche jamais de confirmation sans envoi réel.
# Copiez ce fichier en .env.local pour développer.

RESEND_API_KEY=

# Facultatif — valeurs par défaut dans app/api/reservations/route.ts.
# L'expéditeur doit appartenir à un domaine vérifié dans Resend.
RESERVATION_FROM="Derrière l'Abbaye <reservations@derrierelabbaye.fr>"
RESERVATION_EMAIL_BAR=info@derrierelabbaye.fr

# Développement uniquement : « demo » court-circuite l'envoi et journalise la
# demande dans la console serveur. Sans effet en production.
RESERVATION_MODE=
